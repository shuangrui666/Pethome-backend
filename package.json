{
  "name": "pethome-server",
  "version": "1.0.0",
  "description": "PetHome 宠物家园平台后端 API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "clean": "rimraf dist",
    "seed:shops": "ts-node scripts/seedShops.ts",
    "seed:hospitals": "ts-node scripts/seedHospitals.ts",
    "seed:rescue-bases": "ts-node scripts/seedRescueBases.ts",
    "seed:posts": "ts-node scripts/seedPosts.ts",
    "seed:pets": "ts-node scripts/seedPets.ts",
    "seed:all": "npm run seed:shops && npm run seed:hospitals && npm run seed:rescue-bases && npm run seed:posts && npm run seed:pets"
  },
  "keywords": [
    "pet",
    "adoption",
    "lost-found"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.6.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.6",
    "nodemon": "^3.0.2",
    "rimraf": "^5.0.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
